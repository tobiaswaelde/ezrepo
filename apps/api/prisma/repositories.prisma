model Repository {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerRepositoryId String   @db.VarChar(255)
  owner                String   @db.VarChar(255)
  name                 String   @db.VarChar(255)
  url                  String   @db.VarChar(2048)
  enabled              Boolean  @default(true)
  lastSyncAt           DateTime?
  workflowRunRetentionDays Int?
  retainedRunDurationMs BigInt @default(0)

  providerAccountId String          @db.Uuid
  providerAccount   ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  memberships       RepositoryMembership[]
  notificationChannels NotificationChannel[]
  notificationRules    NotificationRule[]
  syncRequest          RepositorySyncRequest?
  workItemSyncCursors  WorkItemSyncCursor[]
  workItemLabels       WorkItemLabel[]
  issues               Issue[]
  pullRequests         PullRequest[]
  workflowFilters      WorkflowFilter[]
  workflows            Workflow[]
  workflowRuns      WorkflowRun[]

  @@unique([providerAccountId, providerRepositoryId])
  @@index([providerAccountId, enabled])
  @@map("repositories")
}

enum WorkflowFilterMode {
  ALLOW
  DENY
}

model WorkflowFilter {
  id        String             @id @default(uuid()) @db.Uuid
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  pattern String             @db.VarChar(1024)
  mode    WorkflowFilterMode

  repositoryId String     @db.Uuid
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, mode, pattern])
  @@index([repositoryId, mode])
  @@map("workflow_filters")
}

enum RepositoryRole {
  VIEWER
  MANAGER
}

model RepositoryMembership {
  id        String         @id @default(uuid()) @db.Uuid
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  role RepositoryRole @default(VIEWER)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  repositoryId String     @db.Uuid
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([repositoryId])
  @@map("repository_memberships")
}
