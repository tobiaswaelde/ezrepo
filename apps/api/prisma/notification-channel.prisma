/**
 * A global destination with event subscriptions and encrypted credentials.
 */
model NotificationChannel {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                    String                  @unique @db.VarChar(255)
  type                    NotificationChannelType @default(CUSTOM_APPRISE)
  enabled                 Boolean                 @default(true)
  encryptedUrl            String?                 @db.Text
  urlScheme               String?                 @db.VarChar(64)
  requiresReconfiguration Boolean                 @default(false)

  recipients         NotificationChannelRecipient[]
  eventSubscriptions NotificationEventSubscription[]
  deliveries         NotificationDelivery[]
  deliveryAttempts   NotificationDeliveryAttempt[]

  @@index([enabled, name])
  @@map("notification_channels")
}
