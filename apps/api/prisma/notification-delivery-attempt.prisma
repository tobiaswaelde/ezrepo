model NotificationDeliveryAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  attempt       Int
  deliveredAt   DateTime?
  error         String? @db.Text

  notificationDeliveryId String               @db.Uuid
  notificationDelivery   NotificationDelivery @relation(fields: [notificationDeliveryId], references: [id], onDelete: Cascade)

  notificationChannelId String              @db.Uuid
  notificationChannel   NotificationChannel @relation(fields: [notificationChannelId], references: [id], onDelete: Cascade)

  browserPushSubscriptionId String?                  @db.Uuid
  browserPushSubscription   BrowserPushSubscription? @relation(fields: [browserPushSubscriptionId], references: [id], onDelete: SetNull)

  @@index([notificationDeliveryId, notificationChannelId, attempt], map: "notification_delivery_attempts_delivery_channel_attempt_idx")
  @@index([notificationChannelId, createdAt], map: "notification_delivery_attempts_notificationChannelId_createdAt_")
  @@index([browserPushSubscriptionId, createdAt])
  @@map("notification_delivery_attempts")
}
