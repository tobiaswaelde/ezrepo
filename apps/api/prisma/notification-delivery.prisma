model NotificationDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kind             NotificationDeliveryKind   @default(EVENT)
  eventType        NotificationEventType?
  deduplicationKey String                     @db.VarChar(1024)
  status           NotificationDeliveryStatus @default(PENDING)
  finalError       String?                    @db.Text
  nextAttemptAt    DateTime?

  notificationChannelId String              @db.Uuid
  notificationChannel   NotificationChannel @relation(fields: [notificationChannelId], references: [id], onDelete: Cascade)

  repositoryId  String?      @db.Uuid
  repository    Repository?  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  workflowRunId String?      @db.Uuid
  workflowRun   WorkflowRun? @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  issueId       String?      @db.Uuid
  issue         Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pullRequestId String?      @db.Uuid
  pullRequest   PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  requestedByUserId String? @db.Uuid
  requestedBy       User?   @relation("NotificationDeliveryRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  attempts NotificationDeliveryAttempt[]

  @@unique([notificationChannelId, deduplicationKey])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([repositoryId, createdAt])
  @@index([eventType, createdAt])
  @@index([requestedByUserId, createdAt])
  @@map("notification_deliveries")
}
